    <Border x:Name="TgRow" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="0,13,0,13" MinHeight="70">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource ModuleMarkerColumnWidth}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="TgModuleIcon" Data="{StaticResource TelegramGeometry}" Stretch="Uniform" Width="18" MaxHeight="18" Fill="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <Grid Grid.Column="1" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="TG WS Proxy" ToolTip="Original application · its own tray" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="TgVersion" MaxWidth="65" TextTrimming="CharacterEllipsis" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/></Grid>
      <local:ModuleActionGroup Grid.Column="2" VerticalAlignment="Center"><Button x:Name="TgInstall" Style="{StaticResource ModuleAction}" ToolTip="Install" AutomationProperties.Name="Install"><Grid Width="18" Height="18"><Path x:Name="TgInstallGlyph" Style="{StaticResource IconArrow}" Data="{StaticResource DownloadGeometry}"/><ProgressBar x:Name="TgInstallProgress" Visibility="Collapsed" IsIndeterminate="True" Width="18" Height="3" Foreground="{DynamicResource Success}" Background="{DynamicResource Line}" VerticalAlignment="Center"/></Grid></Button>
      <Button x:Name="TgSettings" Style="{StaticResource ModuleAction}" ToolTip="TG WS Proxy settings" AutomationProperties.Name="TG WS Proxy settings"><Path Data="{StaticResource GearGeometry}" Style="{StaticResource IconGear}"/></Button><CheckBox x:Name="TgCheck" Style="{StaticResource ModuleSelection}" ToolTip="Select TG WS Proxy" AutomationProperties.Name="Select TG WS Proxy"/></local:ModuleActionGroup>
      <TextBlock x:Name="TgState" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Text="Checking" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
     </Grid>
    </Border>
    </StackPanel></ScrollViewer>
    <TextBlock x:Name="Message" Grid.Row="2" Text="Close the window — Open Net stays in the tray." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50" Margin="0,15,0,10"/>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Settings" HorizontalAlignment="Left" Padding="0,5" Foreground="{DynamicResource Muted}" FontSize="12"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,7,0"><Canvas Width="20" Height="20"><Path x:Name="SettingsGear" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource GearGeometry}"/></Canvas></Viewbox><TextBlock x:Name="SettingsCaption" Text="Settings" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Grid.Column="1" Text="0.3.3" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid>
  </Grid>
 </Border>
