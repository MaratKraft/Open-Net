   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDown" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource PopupHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="OptionToggle" TargetType="CheckBox"><Setter Property="local:FocusCues.OwnFocusIndicator" Value="True"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent">
     <Grid Width="42" Height="22" VerticalAlignment="Center">
      <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource ToggleSurface}" BorderBrush="{DynamicResource ToggleBorder}" BorderThickness="1"/>
      <Border x:Name="ToggleFocus" CornerRadius="11" BorderBrush="{DynamicResource Focus}" BorderThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource ToggleThumb}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0"/>
     </Grid>
