    <TextBlock Text="TOOLS" Foreground="{DynamicResource ToggleBorder}" FontSize="10" FontWeight="SemiBold" Margin="0,28,0,10"/>
</StackPanel>
    <ScrollViewer x:Name="MainScroll" FocusVisualStyle="{x:Null}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ModuleList">
