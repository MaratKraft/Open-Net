    <Button x:Name="Minimize" Style="{StaticResource CaptionButton}" Grid.Column="1" Width="36" Height="36" VerticalAlignment="Center" Padding="0" ToolTip="Minimize" AutomationProperties.Name="Minimize window"><Path Data="M 0,5 L 10,5" Width="10" Height="10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/></Button>
    <Button x:Name="Close" Tag="close" Style="{StaticResource CaptionButton}" Grid.Column="2" Width="36" Height="36" VerticalAlignment="Center" Padding="0" ToolTip="Close to tray" AutomationProperties.Name="Close window"><Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Width="10" Height="10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/></Button>
