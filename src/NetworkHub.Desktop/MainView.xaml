      <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="ZapretModuleIcon" Data="{StaticResource ZapretGeometry}" Width="18" MaxHeight="18" Stretch="Uniform" Fill="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <Grid Grid.Column="1" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Zapret" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="ZapretVersion" MaxWidth="65" TextTrimming="CharacterEllipsis" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/><TextBlock x:Name="ZapretStrategy" Grid.Column="2" Text="general (ALT13)" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,4,0" TextTrimming="CharacterEllipsis"/></Grid>
      <local:ModuleActionGroup Grid.Column="2" VerticalAlignment="Center"><Button x:Name="ZapretInstall" Style="{StaticResource ModuleAction}" ToolTip="Install" AutomationProperties.Name="Install"><Grid Width="18" Height="18"><Path x:Name="ZapretInstallGlyph" Style="{StaticResource IconArrow}" Data="{StaticResource DownloadGeometry}"/><ProgressBar x:Name="ZapretInstallProgress" Visibility="Collapsed" IsIndeterminate="True" Width="18" Height="3" Foreground="{DynamicResource Success}" Background="{DynamicResource Line}" VerticalAlignment="Center"/></Grid></Button>
      <Button x:Name="ZapretSettings" Style="{StaticResource ModuleAction}" ToolTip="Zapret settings" AutomationProperties.Name="Zapret settings"><Path Data="{StaticResource GearGeometry}" Style="{StaticResource IconGear}"/></Button><CheckBox x:Name="ZapretCheck" Style="{StaticResource ModuleSelection}" ToolTip="Select Zapret" AutomationProperties.Name="Select Zapret"/></local:ModuleActionGroup>
