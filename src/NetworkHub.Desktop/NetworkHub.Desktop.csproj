<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><OutputType>WinExe</OutputType><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><EnableDefaultPageItems>false</EnableDefaultPageItems><AssemblyName>Open Net</AssemblyName><Version>0.3.3</Version><Product>Open Net</Product><Title>Open Net</Title><Description>Windows network tools manager</Description><StartupObject>NetworkHub.Desktop.Program</StartupObject><ApplicationIcon>../../assets/OpenNet.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest></PropertyGroup>
